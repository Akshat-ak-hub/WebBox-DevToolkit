{
  "manifest_version": 3,
  "name": "DevBox — Developer Toolkit",
  "version": "1.0.0",
  "description": "Privacy-first offline developer utilities for JSON, Base64, URLs, UUIDs, timestamps & more. No data ever leaves your browser.",
  "action": {
    "default_title": "DevBox"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Open DevBox Toolkit"
    }
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  }
}
